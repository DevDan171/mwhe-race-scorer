{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MWHE Race Scorer",
  "version": "0.1.1",
  "identifier": "com.midwesthardenduro.scorer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MWHE Race Scorer",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Midwest Hard Enduro",
    "homepage": "https://midwesthardenduro.com",
    "shortDescription": "Offline race-day scoring for the Midwest Hard Enduro series.",
    "longDescription": "MWHE Race Scorer keeps race day on the laptop. Sign in, import an event, register riders, and look up emergency contacts. Scoring keeps working with no network.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "createUpdaterArtifacts": false,
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./windows/hooks.nsh",
        "compression": "lzma"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_THE_MINISIGN_PUBLIC_KEY",
      "endpoints": [
        "https://github.com/DevDan171/mwhe-race-scorer/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
