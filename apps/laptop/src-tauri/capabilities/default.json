{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Race prep permissions: local SQLite, the site HTTP client, and the OS credential store.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-credential-commands",
    "allow-sign-in-commands",
    "allow-sync-commands",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://midwesthardenduro.com/*" },
        { "url": "https://*.midwesthardenduro.com/*" },
        { "url": "http://127.0.0.1:*/*" },
        { "url": "http://localhost:*/*" },
        { "url": "https://github.com/DevDan171/mwhe-race-scorer/releases/*" }
      ]
    },
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "process:allow-restart",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://midwesthardenduro.com/*" },
        { "url": "https://*.midwesthardenduro.com/*" },
        { "url": "https://base44.app/*" },
        { "url": "http://127.0.0.1:*/*" },
        { "url": "http://localhost:*/*" }
      ]
    }
  ]
}
